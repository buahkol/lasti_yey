# SiMonPro server configuration (copy to .env). All values are optional.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=simonpro
DB_USER=postgres
DB_PASSWORD=secret

# patchcore | stub (stub: score = brightness, for testing without a model)
MODEL_BACKEND=patchcore
MODEL_DIR=/mnt/storage/simonpro/models
TORCH_DEVICE=auto

IMAGE_DIR=/mnt/storage/simonpro/images
DATASET_DIR=/mnt/storage/simonpro/data

NG_TOLERANCE=0.05
SESSION_HOURS=12

# Enable POST /api/v1/dev/capture while collecting training photos
ENABLE_DEV_CAPTURE=0
